# ---------------------------------------------------------------------------
# Boathouse environment variables
# Copy to `.env.local` for local dev, and add the same keys in Vercel.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Dashboard: Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (safe to expose in the browser; RLS protects data)
# Dashboard: Project Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, never exposed to the browser.
# Used for coach-triggered invites (admin.inviteUserByEmail). Keep it secret.
# Dashboard: Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL of the deployed site, used to build invite/reset redirect
# links, e.g. https://boathouse.vercel.app  (no trailing slash).
# For local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
